{
  "name": "harness-session-delete",
  "version": "1.1.0",
  "description": "DeepSeek Harness plugin: delete a session permanently — sidebar menu entry with confirmation, conservative refusals, audit log, and offline verification tools.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "session",
    "delete"
  ],
  "homepage": "https://github.com/rdwnivan/harness-session-delete#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rdwnivan/harness-session-delete.git"
  },
  "bugs": {
    "url": "https://github.com/rdwnivan/harness-session-delete/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/client.mjs",
    "check": "node --check index.js && node --check client.js && node --check test/smoke.mjs && node --check test/client.mjs && node --check test/verify-live.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
